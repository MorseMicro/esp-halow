# BOARD: Seeed XIAO ESP32C3
# HAT: Seeed XIAO WM6108

# Pin configuration
CONFIG_MM_RESET_N=2
CONFIG_MM_WAKE=3
CONFIG_MM_BUSY=6
CONFIG_MM_SPI_SCK=8
CONFIG_MM_SPI_MOSI=10
CONFIG_MM_SPI_MISO=9
CONFIG_MM_SPI_CS=5
CONFIG_MM_SPI_IRQ=4

# These Seeed boards need two unpopulated resistors footprints to be either
# bridged or populated with a 0 ohm to route busy and wake to the Xiao header.
CONFIG_HALOW_PS_MODE=n

# Morse Micro chip configuration
CONFIG_MM_BCF_FILE="bcf_fgh100mhaamd.bin"
CONFIG_MM_CHIP_MM6108=y
